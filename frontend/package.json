    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "jsdom": "^26.1.0",
    "msw": "^2.7.4",
    "prettier": "3.6.2",
    "react-router-dom": "^7.9.5",
    "tw-animate-css": "1.4.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vitest": "^3.1.1"
