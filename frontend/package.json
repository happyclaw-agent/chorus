{
  "name": "chorus-quality-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "CI=true vite",
    "build": "cross-env NODE_ENV=production vite build",
    "lint": "npm run prettier && eslint .",
    "lint:fix": "npm run prettier:fix && eslint . --fix",
    "preview": "vite preview",
    "test": "vitest --run",
    "test:watch": "vitest",
    "prettier": "prettier --check --config .prettierrc.json ./src",
    "prettier:fix": "prettier --write --config .prettierrc.json ./src",
    "test:e2e": "npx playwright test"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-separator": "1.1.7",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tooltip": "1.2.8",
    "@tailwindcss/vite": "4.1.16",
    "@tanstack/react-query": "5.90.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "vite": "7.1.12"
  },
  "optionalDependencies": {
    "@esbuild/darwin-x64": "^0.25.11",
    "@esbuild/linux-x64": "^0.25.1",
    "@libsql/darwin-x64": "^0.5.22",
    "@libsql/linux-arm64-musl": "^0.5.22",
    "@libsql/linux-x64-gnu": "^0.5.22",
    "@rollup/rollup-darwin-x64": "^4.52.5",
    "@rollup/rollup-linux-arm64-musl": "^4.52.5",
    "@rollup/rollup-linux-x64-gnu": "^4.52.5",
    "lightningcss-darwin-x64": "^1.30.2",
    "lightningcss-linux-arm64-musl": "^1.30.2",
    "lightningcss-linux-x64-gnu": "^1.30.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.58.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "eslint": "^9.21.0",
